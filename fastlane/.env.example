# 이 파일을 fastlane/.env 로 복사해 값을 채운다. fastlane/.env 는 git 이 무시한다.
# 키는 App Store Connect > 사용자 및 액세스 > 통합 > App Store Connect API 에서 Admin 등급으로 발급한다.
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
# .p8 파일은 저장소 밖에 둔다. 예: /Users/<사용자>/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
# .p8 원본은 한 번만 내려받는다. 백업: 팀 Notion, 로컬 ~/.appstoreconnect/
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=
